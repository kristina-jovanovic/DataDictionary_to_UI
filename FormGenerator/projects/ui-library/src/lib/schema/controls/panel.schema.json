{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ui.local/schema/controls/panel.schema.json",
  "type": "object",
  "required": ["controls"],
  "properties": {
    "title": { "type": "string" },
    "tabGroupName": { "type": "string" },
    "layout": { "$ref": "../layout.schema.json", "default": { "type": "Flow" } },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "../control.schema.json" }
    }
  }
}
